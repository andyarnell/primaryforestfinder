var updateLeftPanelWidth = function() {
  var allCollapsed = appState.ui.treeCoverCollapsed && 
                     appState.ui.anthropogenicCollapsed && 
                     appState.ui.limitedAccessCollapsed && 
                     appState.ui.connectivityCollapsed && 
                     appState.ui.advancedSettingsCollapsed;
  
  if (allCollapsed) {
    leftPanel.style().set({width: '160px'});
    leftPanel.widgets().reset([treeCoverPanel, anthropogenicPanel, limitedAccessPanel, connectivityPanel, advancedSettingsPanel]);
  } else {
    leftPanel.style().set({width: '280px'});
