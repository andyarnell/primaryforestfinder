// UPDATE MAP
function updateMap() {
  var selectedCountry = countrySelector.getValue();
  print('Country: ' + selectedCountry);
  print('Year 1: ' + yearSelector1.getValue() + ' | Year 2: ' + yearSelector2.getValue());
  print('Split Screen: ' + enableSplitScreenCheckbox.getValue());
  
  var country = countries.filter(ee.Filter.eq('country_na', selectedCountry));
  
  map.layers().reset();
  countryLabel.setValue(selectedCountry);
  
  if (zoomToCountryCheckbox.getValue()) {
    var centroid = country.geometry().centroid().coordinates().getInfo();
    map.setCenter(centroid[0], centroid[1], 6);
  }
}
